# Copy to .github/workflows/pages.yml (repo Settings > Pages > Source: "GitHub Actions").
name: playground-pages
on:
  push:
    branches: [main]
    paths: ["playground/**", "js/**", "assets/fonts/**"]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 22 }
      # js/*.wasm must be committed (or built in a previous step) before this runs
      - run: node playground/build.mjs
      - uses: actions/upload-pages-artifact@v3
        with: { path: playground/dist }
      - id: deployment
        uses: actions/deploy-pages@v4
