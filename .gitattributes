# Byte-exact reference data compared in tests (no end-of-line conversion on checkout).
src/pdf/testdata/*.txt -text
# Keep imported upstream blobs byte-identical to the corpus integrity manifest.
tests/upstream/takumi/** -text
# Generated by scripts (npm-platform-packages.mjs, build.mjs) with LF endings: check out as LF so a rebuild
# does not show them as modified (scripts/publish.mjs refuses to release from a dirty tree).
npm/*/package.json text eol=lf
npm/*/README.md text eol=lf
js/build-manifest.json text eol=lf
